<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Моя галерея посилань</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            max-width: 1000px;
            width: 100%;
        }
        .card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }
        .card:hover {
            transform: scale(1.05);
        }
        .card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .card-content {
            padding: 15px;
            text-align: center;
        }
        .card-content a {
            text-decoration: none;
            color: #007bff;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <h1>Мої зображення та посилання</h1>

    <div class="gallery">
        <div class="card">
            <img src="https://via.placeholder.com/300" alt="Опис фото 1">
            <div class="card-content">
                <a href="https://google.com" target="_blank">Перейти за посиланням 1</a>
            </div>
        </div>

        <div class="card">
            <img src="https://via.placeholder.com/300" alt="Опис фото 2">
            <div class="card-content">
                <a href="https://github.com" target="_blank">Перейти за посиланням 2</a>
            </div>
        </div>
        
        </div>

</body>
</html>
